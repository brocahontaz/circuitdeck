# CircuitDeck configuration (development defaults)
# Copy to .env for docker compose to pick up overrides.
#
# Development modes (mutually exclusive):
#   mock mode      fast, no Factorio required (default)
#   real mode      a real Factorio dedicated server + graftorio3 metrics
#
#   docker compose --profile mock up --build        # mock mode
#   docker compose --profile factorio up --build    # real Factorio mode
#
# Copying this file to .env makes plain `docker compose up` use mock mode
# (via COMPOSE_PROFILES=mock below).

# Select which optional service group starts when no --profile flag is given.
COMPOSE_PROFILES=mock

# --- Mode selection -----------------------------------------------------------
# Leave BOTH variables below EMPTY: the compose entrypoint then auto-selects
# the metrics source based on which mode is running (mock vs factorio
# profile). Set them only for explicit production-style overrides, e.g.
#   FACTORIO_METRICS_TARGET=your-factorio-host:9100
#   FACTORIO_RECORDING_RULES=true
FACTORIO_METRICS_TARGET=
FACTORIO_RECORDING_RULES=

# --- Real Factorio mode -------------------------------------------------------
# Server image tag (factoriotools/factorio). latest = newest Factorio 2.1.
FACTORIO_VERSION=latest

# Name of the save created on first start (kept in the factorio-data volume).
FACTORIO_SAVE_NAME=circuitdeck-dev

# Map generation preset for the first start (default/rich-resources/
# marathon/death-world/rail-world/ribbon-world; empty = map-gen defaults).
FACTORIO_PRESET=

# Local ports for the game (UDP) and RCON (TCP, published to localhost only).
FACTORIO_GAME_PORT=34197
FACTORIO_RCON_PORT=27015

# Safe local-development credentials; not committed secrets. RCON password
# is also usable via `docker exec circuitdeck-factorio rcon /h`.
FACTORIO_RCON_PASSWORD=circuitdeck
FACTORIO_GAME_PASSWORD=

# Set true to re-render server-settings.json from the repo template on next
# start (save data is untouched).
FACTORIO_FORCE_BOOTSTRAP=false

# --- Backend ------------------------------------------------------------------
# Bind address of the Rust API inside its container.
CIRCUITDECK_BIND_ADDR=0.0.0.0:8080

# Prometheus base URL used by the backend (docker-internal hostname).
PROMETHEUS_URL=http://prometheus:9090

# Query / probe timeouts (seconds).
PROMETHEUS_QUERY_TIMEOUT_SECS=10
PROMETHEUS_PING_TIMEOUT_SECS=3

# Comma-separated CORS origins allowed to call the API (empty = same-origin only).
CIRCUITDECK_CORS_ORIGINS=

# --- Frontend -----------------------------------------------------------------
# Base URL the browser uses to reach the API. Default `/api` works when the
# frontend container proxies /api to the backend (compose does this).
# Set to e.g. https://factorio.example.com/api when the API is exposed elsewhere.
VITE_API_BASE_URL=/api