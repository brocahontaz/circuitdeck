# CircuitDeck frontend (Svelte 5 + Vite) — multi-stage, non-root, served by Caddy.
FROM node:22-alpine AS build
WORKDIR /build

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

FROM caddy:2-alpine AS runtime

# Non-root runtime: dedicated dirs Caddy actually needs (certs/config storage),
# owned by the unprivileged user. The Caddyfile disables the admin endpoint.
RUN adduser -D -H -u 1000 -s /sbin/nologin web \
    && mkdir -p /data /config /etc/caddy \
    && chown -R 1000:1000 /data /config

COPY --chown=1000:1000 docker/frontend.Caddyfile /etc/caddy/Caddyfile
COPY --from=build --chown=1000:1000 /build/dist /srv

ENV XDG_DATA_HOME=/data \
    XDG_CONFIG_HOME=/config

USER 1000
EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD caddy version >/dev/null 2>&1 && nc -z 127.0.0.1 8080 || exit 1

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
